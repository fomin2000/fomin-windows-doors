---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import UiIcon from '../components/UiIcon.astro';
import { SITE, estimateMailto } from '../data/site';
---
<Base
  title="Contact Us & Free Estimates"
  description="Request a free window or door estimate from Fomin Windows & Doors. Call (503) 583-7956 or email fominwindowsanddoors@gmail.com. Serving Salem, OR and within 40 miles."
>
  <PageHero
    title="Get your free estimate"
    eyebrow="Contact"
    lead={`Call or email us to schedule a free, no-pressure estimate. We serve Salem, Oregon and communities within about ${SITE.serviceRadiusMiles} miles.`}
    crumbs={[{ label: 'Contact' }]}
    ctas={false}
  />

  <section class="section" id="estimate">
    <div class="container">
      <div class="grid grid-2 contact-cards">
        <a class="card card--link contact-card" href={SITE.phoneHref}>
          <span class="contact-card__icon"><UiIcon name="phone" size={30} /></span>
          <h2 class="h3">Call us</h2>
          <p class="contact-card__value">{SITE.phoneDisplay}</p>
          <p>The fastest way to reach us. If we miss your call, leave a message and we will call you back.</p>
          <span class="btn btn--primary btn--lg">Tap to call</span>
        </a>
        <a class="card card--link contact-card" href={estimateMailto}>
          <span class="contact-card__icon"><UiIcon name="mail" size={30} /></span>
          <h2 class="h3">Email us</h2>
          <p class="contact-card__value contact-card__email">{SITE.email}</p>
          <p>Opens your email app with an estimate request template you can fill in and send.</p>
          <span class="btn btn--primary btn--lg">Email an estimate request</span>
        </a>
      </div>

      <p class="form-note">
        <strong>Note:</strong> we don't have an online request form yet. Please call or email us directly — messages
        are not collected anywhere else on this website.
      </p>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container split split--top">
      <div>
        <h2>Helpful details to include</h2>
        <p class="lead">Sharing a few details up front helps us prepare for your estimate.</p>
        <ul class="check-list">
          <li>Your name and the best phone number to reach you</li>
          <li>Project address or city</li>
          <li>What you need: windows, doors, dry rot repair, waterproofing or trim</li>
          <li>Approximate number and type of windows or doors</li>
          <li>Photos of the windows, doors or damaged areas (attach them to your email)</li>
          <li>Best days and times for a visit</li>
        </ul>
      </div>
      <div class="card info-card">
        <h2 class="h3">Business information</h2>
        <dl>
          <div><dt>Phone</dt><dd><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a href={SITE.emailHref}>{SITE.email}</a></dd></div>
          <div><dt>Service area</dt><dd>Salem, OR and communities within ~{SITE.serviceRadiusMiles} miles — <a href="/locations/salem-or/#service-area">see the list</a></dd></div>
          {SITE.businessHours && <div><dt>Hours</dt><dd>{SITE.businessHours}</dd></div>}
          {SITE.ccbLicense && <div><dt>Oregon CCB #</dt><dd>{SITE.ccbLicense}</dd></div>}
          {SITE.streetAddress && <div><dt>Address</dt><dd>{SITE.streetAddress}</dd></div>}
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .h3 { font-size: 1.5rem; }
  .split--top { align-items: start; }
  .contact-card { display: flex; flex-direction: column; align-items: flex-start; height: 100%; }
  .contact-card p { color: var(--gray-600); }
  .contact-card .btn { margin-top: auto; }
  .contact-card__icon {
    display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%;
    background: var(--blue-50); color: var(--blue); margin-bottom: 16px;
  }
  .contact-card__value { font-size: clamp(1.375rem, 2.5vw, 1.875rem); font-weight: 800; color: var(--navy) !important; margin-bottom: 8px; letter-spacing: -0.01em; }
  .contact-card__email { font-size: clamp(1.0625rem, 2vw, 1.375rem); word-break: break-all; }
  .form-note { margin-top: 28px; padding: 16px 20px; border-radius: var(--radius); background: var(--gray); font-size: 0.9375rem; }
  .info-card dl { margin: 0; display: grid; gap: 16px; }
  .info-card dt { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-600); font-weight: 600; }
  .info-card dd { margin: 2px 0 0; font-weight: 600; color: var(--navy); }
</style>
