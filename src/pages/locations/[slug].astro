---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import CertifiedSection from '../../components/CertifiedSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import MissingNote from '../../components/MissingNote.astro';
import UiIcon from '../../components/UiIcon.astro';
import { locations, type Location } from '../../data/locations';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return locations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}
const { location: l } = Astro.props as { location: Location };
const active = l.status === 'active';
const isCA = l.state === 'CA';
const others = locations.filter((o) => o.slug !== l.slug);
const interestMailto = `${SITE.emailHref}?subject=${encodeURIComponent(`${l.city}, ${l.state} branch — keep me posted`)}`;
---
<Base title={`${l.city}, ${l.state} Windows & Doors`} description={l.description}>
  <PageHero
    title={l.headline}
    eyebrow={active ? `${l.city}, ${l.stateName} · Now serving` : `${l.city}, ${l.stateName} · Coming soon`}
    lead={l.intro[0]}
    crumbs={[{ label: 'Locations', href: '/locations/' }, { label: `${l.city}, ${l.state}` }]}
    ctas={!isCA}
  >
    {
      isCA && (
        <div class="btn-row hero-ca">
          <a class="btn btn--primary btn--lg" href={interestMailto}>
            <UiIcon name="mail" />
            Email us to stay informed
          </a>
        </div>
      )
    }
    <Photo
      slot="media"
      name={`location-${l.slug}`}
      alt={`Homes in ${l.city}, ${l.stateName}`}
      need={`A daylight photo for the ${l.city} page — ideally a project you completed in or near ${l.city}.`}
      icon={isCA ? 'sliding-door' : 'double-hung'}
      eager
    />
  </PageHero>

  <section class="section">
    <div class="container split split--top">
      <div class="prose">
        <h2>{active ? `Serving ${l.city} and nearby communities` : `About the ${l.city} branch`}</h2>
        {l.intro.slice(1).map((t) => <p class="lead">{t}</p>)}
        {
          !active && (
            <div class="status card">
              <span class="pill pill--soon">Coming soon</span>
              <p>
                {isCA
                  ? `The ${l.city} branch is in the planning stage. We are not yet accepting projects in California.`
                  : `The ${l.city} branch is not open yet. Until it opens, call or email us — many south-metro addresses are already within our Salem service area.`}
              </p>
            </div>
          )
        }
        <MissingNote>
          {l.city} branch details — {active ? 'office/showroom address (if you have one), business hours' : 'opening date, branch address, local phone number (if different), business hours'}
          {isCA ? ', and a California CSLB contractor license number (required before offering work in California)' : ''}.
        </MissingNote>
      </div>
      <div class="card branch-card">
        <h2 class="h3">{l.city} branch contact</h2>
        <ul class="branch-contact">
          <li><UiIcon name="phone" size={18} /><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></li>
          <li><UiIcon name="mail" size={18} /><a href={SITE.emailHref}>{SITE.email}</a></li>
          <li><UiIcon name="pin" size={18} />{l.city}, {l.stateName}</li>
        </ul>
        <p class="small">
          {isCA ? 'Status: planned branch — not yet open.' : active ? 'Status: open and serving customers.' : 'Status: opening soon.'}
        </p>
      </div>
    </div>
  </section>

  <section class="section section--gray" id="service-area">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{active ? 'Service area' : 'Planned service area'}</p>
        <h2>
          {active ? `Communities we serve within about ${SITE.serviceRadiusMiles} miles of ${l.city}` : `Communities the ${l.city} branch plans to serve`}
        </h2>
        <p class="lead">{l.areasNote}</p>
      </div>
      <ul class="areas">
        {
          l.areas.map((a) => (
            <li>
              <span>{a.name}, {l.state}</span>
              {typeof a.miles === 'number' && a.miles > 0 && <span class="areas__mi">~{a.miles} mi</span>}
            </li>
          ))
        }
      </ul>
      <p class="areas-cta">
        Don't see your city? <a href={SITE.phoneHref}>Call {SITE.phoneDisplay}</a> or <a href={SITE.emailHref}>email us</a>{' '}
        to check your address.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Windows &amp; doors for {l.city}-area homes</h2>
      </div>
      <div class="grid grid-3">
        {
          l.climateNotes.map((c) => (
            <div class="card">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    !isCA && (
      <>
        <section class="section section--gray">
          <div class="container">
            <div class="section-head">
              <h2>Services {active ? 'in' : 'planned for'} {l.city}</h2>
            </div>
            <ServiceCards />
          </div>
        </section>
        <CertifiedSection />
      </>
    )
  }

  <section class="section">
    <div class="container">
      <h2>Other locations</h2>
      <ul class="other-locs">
        {
          others.map((o) => (
            <li>
              <a href={`/locations/${o.slug}/`}>{o.city}, {o.state}</a>
              <span class:list={['pill', { 'pill--soon': o.status !== 'active' }]}>{o.status === 'active' ? 'Now serving' : 'Coming soon'}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    isCA ? (
      <CtaBand
        title="Live in Oregon?"
        text="Our Salem branch is open now and serves communities within about 40 miles of Salem. Call or email for a free estimate."
      />
    ) : (
      <CtaBand />
    )
  }
</Base>

<style>
  .split--top { align-items: start; }
  .h3 { font-size: 1.25rem; }
  .hero-ca { margin-top: 24px; }
  .status { background: var(--amber-50); border-color: #f1d9a6; margin-bottom: 1em; }
  .status p { margin: 10px 0 0; }
  .branch-card { background: var(--gray); border: 0; }
  .branch-contact { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 12px; }
  .branch-contact li { overflow-wrap: anywhere; display: flex; align-items: center; gap: 10px; font-weight: 600; color: var(--navy); }
  .branch-contact :global(svg) { color: var(--blue); flex: none; }
  .small { font-size: 0.875rem; color: var(--gray-600); margin: 0; }
  .areas {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 8px 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
  }
  .areas li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
    background: var(--white); border: 1px solid var(--gray-200); border-radius: 10px;
    padding: 10px 14px; font-weight: 600; color: var(--navy);
  }
  .areas__mi { font-size: 0.8125rem; font-weight: 500; color: var(--gray-600); white-space: nowrap; }
  .areas-cta { margin-top: 24px; }
  .other-locs { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .other-locs li { display: flex; align-items: center; gap: 10px; font-weight: 650; }
</style>
