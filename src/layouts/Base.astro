---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { SITE } from '../data/site';
import { locations } from '../data/locations';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, schema } = Astro.props;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

// Business structured data — only includes information that is confirmed.
const salem = locations.find((l) => l.slug === 'salem-or')!;
const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  url: SITE.url,
  telephone: '+1-503-583-7956',
  email: SITE.email,
  image: ogImage,
  logo: new URL('/logo.png', Astro.site).href,
  areaServed: salem.areas.map((a) => ({ '@type': 'City', name: `${a.name}, OR` })),
};
if (SITE.streetAddress) {
  business.address = { '@type': 'PostalAddress', streetAddress: SITE.streetAddress, addressRegion: 'OR', addressCountry: 'US' };
}
const schemas = [business, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#15324F" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <script>
      // Fade sections in as they scroll into view (skipped for reduced-motion visitors).
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const selectors = [
          '.hero__text > *',
          '.hero__media',
          '.page-hero__text > *',
          '.page-hero__media',
          'main .section-head',
          'main .grid > *',
          'main .styles > li',
          'main .steps > li',
          'main .brands > li',
          'main .split > *',
          'main .area-chips',
          'main .areas',
          'main .gallery > li',
          'main .faq',
          '.cta-band__inner > *',
        ];
        const targets = document.querySelectorAll<HTMLElement>(selectors.join(','));
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              observer.unobserve(el);
              el.classList.add('is-visible');
              // Hand the element back to its own hover transitions once revealed
              const done = (ev: TransitionEvent) => {
                if (ev.target !== el) return;
                el.removeEventListener('transitionend', done);
                el.classList.remove('reveal', 'is-visible');
                el.style.removeProperty('--reveal-delay');
              };
              el.addEventListener('transitionend', done);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => {
          if (el.closest('.reveal')) return; // already animated by a parent
          const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
          const index = Math.max(0, siblings.indexOf(el));
          el.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 70}ms`);
          el.classList.add('reveal');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
