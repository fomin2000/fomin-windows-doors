---
import Icon from './Icon.astro';
import type { Product } from '../data/products';
interface Props {
  items: Product[];
  base: '/windows/' | '/doors/';
  showBlurb?: boolean;
}
const { items, base, showBlurb = true } = Astro.props;
---
<ul class="styles">
  {
    items.map((p) => (
      <li>
        <a class="style" href={`${base}${p.slug}/`}>
          <span class="style__icon">
            <Icon name={p.icon} size={64} />
          </span>
          <span class="style__name">{p.name}</span>
          {showBlurb && <span class="style__blurb">{p.blurb}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Rows wrap and the last row is centered, so short lists (like doors) stay balanced */
  .styles {
    --gap: 12px;
    --cols: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }
  .styles > li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
  }
  @media (min-width: 481px) {
    .styles {
      --gap: 16px;
      --cols: 3;
    }
  }
  @media (min-width: 760px) {
    .styles {
      --cols: 4;
    }
  }
  @media (min-width: 1100px) {
    .styles {
      --cols: 6;
    }
  }
  .style {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    height: 100%;
    padding: 22px 14px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    color: var(--navy);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      color 0.2s ease,
      transform 0.25s ease;
  }
  .style:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow);
    color: var(--blue);
    transform: translateY(-3px);
  }
  .style__icon {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 16px;
    background: var(--gray);
    transition: background-color 0.25s ease;
  }
  .style:hover .style__icon {
    background: var(--blue-50);
  }
  .style__name {
    font-weight: 700;
    line-height: 1.3;
  }
  .style__blurb {
    font-size: 0.875rem;
    color: var(--gray-600);
    line-height: 1.4;
  }
</style>
