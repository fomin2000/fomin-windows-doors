---
// A visible "Content needed" note. Only renders while SHOW_MISSING_CONTENT_NOTES
// is true in src/data/site.ts. Every note is also listed in MISSING_CONTENT.md.
import { SHOW_MISSING_CONTENT_NOTES } from '../data/site';
interface Props {
  inline?: boolean;
}
const { inline = false } = Astro.props;
---
{
  SHOW_MISSING_CONTENT_NOTES &&
    (inline ? (
      <span class="missing missing--inline">
        <strong>Content needed:</strong> <slot />
      </span>
    ) : (
      <p class="missing">
        <strong>Content needed:</strong> <slot />
      </p>
    ))
}

<style>
  .missing {
    border: 1.5px dashed #d99a2b;
    background: var(--amber-50);
    color: #6b4200;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 1em;
  }
  .missing--inline {
    display: inline-block;
    padding: 2px 8px;
    margin: 0;
  }
</style>
