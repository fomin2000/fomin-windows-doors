---
// Manufacturer logos on uniform white cards. Logo files live in
// src/assets/brands/<slug>.svg|png|webp. A brand without a file shows its name instead.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { brands } from '../data/brands';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brands/*.{svg,png,webp,jpg}', { eager: true });
const logoFor = (slug: string) =>
  Object.entries(files).find(([p]) => p.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === slug)?.[1].default;

// Give every logo roughly the same visual weight: long, thin wordmarks get less
// height and compact marks get more, so no logo looks oversized next to the others.
const TARGET_AREA = 7200; // px² at desktop size
const sizeFor = (logo: ImageMetadata) => {
  const ratio = logo.width / logo.height;
  const height = Math.round(Math.min(56, Math.max(26, Math.sqrt(TARGET_AREA / ratio))));
  return { height, width: Math.round(height * ratio) };
};
---
<ul class="brands">
  {
    brands.map((b) => {
      const logo = logoFor(b.slug);
      const size = logo && sizeFor(logo);
      return (
        <li class="brand">
          {logo && size ? (
            <Image
              src={logo}
              alt={b.name}
              width={size.width}
              height={size.height}
              densities={logo.format === 'svg' ? undefined : [1, 2]}
              class="brand__logo"
              style={`--logo-h:${size.height}px`}
            />
          ) : (
            <span class="brand__name">{b.name}</span>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .brands {
    --gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }
  .brand {
    /* 2 per row on phones, 3 on tablets, 4 on desktop (the last row is centered) */
    flex: 0 0 calc((100% - var(--gap)) / 2);
    display: grid;
    place-items: center;
    min-height: 96px;
    padding: 18px 16px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgb(13 34 54 / 4%);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .brand:hover {
    border-color: #cfd8e3;
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  @media (min-width: 640px) {
    .brand {
      flex-basis: calc((100% - 2 * var(--gap)) / 3);
      min-height: 112px;
      padding: 24px;
    }
  }
  @media (min-width: 960px) {
    .brand {
      flex-basis: calc((100% - 3 * var(--gap)) / 4);
      min-height: 120px;
    }
  }
  .brand__logo {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(var(--logo-h) * 0.72);
    object-fit: contain;
  }
  @media (min-width: 640px) {
    .brand__logo {
      max-height: var(--logo-h);
    }
  }
  .brand__name {
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: 0.01em;
    color: var(--navy);
    text-align: center;
  }
</style>
