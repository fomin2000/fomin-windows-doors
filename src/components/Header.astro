---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import UiIcon from './UiIcon.astro';
import { SITE, ESTIMATE_HREF } from '../data/site';
import { navGroups, navLinks } from '../data/nav';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
const inSection = (href: string) => href !== '/' && path.startsWith(href);
---
<div class="utility">
  <div class="container utility__inner">
    <p class="utility__area">
      <UiIcon name="pin" size={16} />
      Serving Salem, OR &amp; communities within {SITE.serviceRadiusMiles} miles ·
      <a href="/locations/">Find your branch</a>
    </p>
    <div class="utility__contact">
      <a href={SITE.emailHref}><UiIcon name="mail" size={16} />{SITE.email}</a>
      <a href={SITE.phoneHref}><UiIcon name="phone" size={16} />{SITE.phoneDisplay}</a>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label={`${SITE.name} — home`}>
      <Logo />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul class="desktop-nav__list">
        {
          navGroups.map((g) => (
            <li class="nav-item" data-nav-item>
              <button
                class:list={['nav-trigger', { 'is-section': inSection(g.href) }]}
                type="button"
                aria-expanded="false"
                aria-controls={`mega-${g.id}`}
                data-nav-trigger
              >
                {g.label}
                <UiIcon name="chevron" size={16} />
              </button>
              <div class="mega" id={`mega-${g.id}`} data-mega hidden>
                <div class="container mega__inner">
                  <div class="mega__main">
                    <p class="mega__title">{g.intro}</p>
                    <ul class:list={['mega__grid', { 'mega__grid--icons': g.iconGrid }]}>
                      {g.items.map((item) => (
                        <li>
                          <a href={item.href} class="mega__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                            {item.icon && (
                              <span class="mega__icon">
                                <Icon name={item.icon} size={g.iconGrid ? 56 : 36} />
                              </span>
                            )}
                            <span class="mega__text">
                              <span class="mega__label">
                                {item.label}
                                {item.badge && <span class="pill pill--soon">{item.badge}</span>}
                              </span>
                              {item.blurb && <span class="mega__blurb">{item.blurb}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <aside class="mega__side">
                    {g.side ? (
                      <>
                        <p class="mega__title">{g.side.title}</p>
                        <ul class="mega__side-links">
                          {g.side.links.map((l) => (
                            <li>
                              <a href={l.href}>{l.label}</a>
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <p class="mega__title">
                        <a href={g.href}>{g.label} overview</a>
                      </p>
                    )}
                    <div class="mega__cta">
                      <p>Not sure what you need? Talk with a certified master installer.</p>
                      <a class="btn btn--primary" href={ESTIMATE_HREF}>Get a free estimate</a>
                      <a class="mega__phone" href={SITE.phoneHref}>
                        <UiIcon name="phone" size={16} />
                        {SITE.phoneDisplay}
                      </a>
                    </div>
                  </aside>
                </div>
              </div>
            </li>
          ))
        }
        {
          navLinks.map((l) => (
            <li class="nav-item">
              <a
                class:list={['nav-link', { 'is-section': inSection(l.href) }]}
                href={l.href}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={SITE.phoneHref}>
        <UiIcon name="phone" size={18} />
        <span>{SITE.phoneDisplay}</span>
      </a>
      <a class="btn btn--primary header__cta" href={ESTIMATE_HREF}>Free Estimate</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="menu-toggle__open"><UiIcon name="menu" size={26} /></span>
        <span class="menu-toggle__close"><UiIcon name="close" size={26} /></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Main" data-mobile-nav hidden>
    <div class="container">
      <ul class="mobile-nav__list">
        {
          navGroups.map((g) => (
            <li>
              <details>
                <summary>
                  {g.label}
                  <UiIcon name="chevron" size={20} />
                </summary>
                <ul class:list={['mobile-nav__sub', { 'mobile-nav__sub--icons': g.iconGrid }]}>
                  {g.items.map((item) => (
                    <li>
                      <a href={item.href}>
                        {item.icon && g.iconGrid && <Icon name={item.icon} size={40} />}
                        <span>
                          {item.label}
                          {item.badge && <span class="pill pill--soon">{item.badge}</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                  <li class="mobile-nav__all">
                    <a href={g.href}>View all {g.label.toLowerCase()} →</a>
                  </li>
                </ul>
              </details>
            </li>
          ))
        }
        {
          navLinks.map((l) => (
            <li>
              <a class="mobile-nav__link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-nav__contact">
        <a class="btn btn--outline" href={SITE.phoneHref}><UiIcon name="phone" />Call {SITE.phoneDisplay}</a>
        <a class="btn btn--outline" href={SITE.emailHref}><UiIcon name="mail" />Email us</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const items = Array.from(header.querySelectorAll<HTMLElement>('[data-nav-item]')).filter((li) =>
      li.querySelector('[data-nav-trigger]'),
    );
    let closeTimer: number | undefined;

    const setOpen = (li: HTMLElement, open: boolean) => {
      const btn = li.querySelector<HTMLButtonElement>('[data-nav-trigger]')!;
      const panel = li.querySelector<HTMLElement>('[data-mega]')!;
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      li.classList.toggle('is-open', open);
    };
    const closeAll = (except?: HTMLElement) => items.forEach((li) => li !== except && setOpen(li, false));

    items.forEach((li) => {
      const btn = li.querySelector<HTMLButtonElement>('[data-nav-trigger]')!;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        closeAll(li);
        setOpen(li, open);
      });
      // Open on hover for mouse users (with a short delay before closing)
      li.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        window.clearTimeout(closeTimer);
        closeAll(li);
        setOpen(li, true);
      });
      li.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse') return;
        closeTimer = window.setTimeout(() => setOpen(li, false), 180);
      });
      li.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (next && !li.contains(next)) setOpen(li, false);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = items.find((li) => li.classList.contains('is-open'));
      if (open) {
        setOpen(open, false);
        open.querySelector<HTMLButtonElement>('[data-nav-trigger]')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeAll();
    });

    // Mobile menu
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobileNav = header.querySelector<HTMLElement>('[data-mobile-nav]');
    if (toggle && mobileNav) {
      const setMenu = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        mobileNav.hidden = !open;
        document.documentElement.classList.toggle('menu-open', open);
      };
      toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          toggle.focus();
        }
      });
      window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => e.matches && setMenu(false));
    }
  }
</script>

<style>
  .utility {
    background: var(--navy-900);
    color: #c9d6e3;
    font-size: 0.875rem;
  }
  .utility__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 40px;
  }
  .utility p {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .utility a {
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }
  .utility a:hover {
    text-decoration: underline;
  }
  .utility__contact {
    display: flex;
    gap: 24px;
  }
  .utility__contact a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 899px) {
    .utility {
      display: none;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--gray-200);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: var(--header-h);
  }
  .header__logo {
    text-decoration: none;
    flex: none;
  }

  .desktop-nav {
    display: none;
  }
  .desktop-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav-trigger,
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: var(--header-h);
    padding: 0 11px;
    white-space: nowrap;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9688rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    cursor: pointer;
    position: relative;
  }
  .nav-trigger::after,
  .nav-link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: transparent;
  }
  .nav-trigger:hover,
  .nav-link:hover,
  .nav-item.is-open .nav-trigger {
    color: var(--blue);
  }
  .nav-item.is-open .nav-trigger::after,
  .nav-link[aria-current='page']::after,
  .is-section::after {
    background: var(--blue);
  }
  .nav-trigger :global(svg) {
    transition: transform 0.15s ease;
  }
  .nav-item.is-open .nav-trigger :global(svg) {
    transform: rotate(180deg);
  }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--white);
    border-top: 1px solid var(--gray-200);
    box-shadow: 0 24px 40px rgb(13 34 54 / 14%);
  }
  .mega__inner {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
    padding-block: 32px 36px;
  }
  .mega__title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray-600);
    margin-bottom: 16px;
  }
  .mega__title a {
    color: var(--blue);
  }
  .mega__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px 24px;
  }
  .mega__grid--icons {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }
  .mega__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 12px;
    border-radius: var(--radius);
    color: var(--navy);
    text-decoration: none;
  }
  .mega__link:hover,
  .mega__link[aria-current='page'] {
    background: var(--gray);
    color: var(--blue);
  }
  .mega__icon {
    flex: none;
    color: var(--navy);
  }
  .mega__grid--icons .mega__link {
    flex-direction: column;
    text-align: center;
    gap: 10px;
    padding: 16px 8px 14px;
    height: 100%;
  }
  .mega__grid--icons .mega__icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 14px;
    background: var(--gray);
    transition: background-color 0.15s ease;
  }
  .mega__grid--icons .mega__link:hover .mega__icon {
    background: var(--blue-50);
    color: var(--blue);
  }
  .mega__grid--icons .mega__link:hover {
    background: transparent;
  }
  .mega__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mega__label {
    font-weight: 650;
    font-size: 0.9688rem;
    line-height: 1.3;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .mega__grid--icons .mega__label {
    justify-content: center;
  }
  .mega__blurb {
    font-size: 0.8125rem;
    color: var(--gray-600);
    line-height: 1.4;
  }
  .mega__side {
    border-left: 1px solid var(--gray-200);
    padding-left: 32px;
  }
  .mega__side-links {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 10px;
  }
  .mega__side-links a {
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
  }
  .mega__side-links a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  .mega__cta {
    background: var(--gray);
    border-radius: var(--radius-lg);
    padding: 20px;
  }
  .mega__cta p {
    font-size: 0.9375rem;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .mega__cta .btn {
    width: 100%;
  }
  .mega__phone {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-weight: 650;
    color: var(--navy);
    text-decoration: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header__phone {
    display: none;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
  }
  .header__phone:hover {
    color: var(--blue);
  }
  .header__cta {
    display: none;
  }
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
  }
  .menu-toggle__close {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: block;
  }

  @media (min-width: 600px) {
    .header__cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1100px) {
    .desktop-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-nav {
      display: none !important;
    }
  }
  @media (min-width: 1440px) {
    .header__phone {
      display: inline-flex;
    }
  }

  /* Mobile navigation */
  .mobile-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - var(--header-h));
    background: var(--white);
    overflow-y: auto;
    padding-block: 8px calc(var(--mobile-bar-h) + 32px);
    border-top: 1px solid var(--gray-200);
  }
  .mobile-nav__list,
  .mobile-nav__sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav__list > li {
    border-bottom: 1px solid var(--gray-200);
  }
  .mobile-nav summary,
  .mobile-nav__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--navy);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav details[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .mobile-nav__sub {
    padding-bottom: 16px;
    display: grid;
    gap: 2px;
  }
  .mobile-nav__sub a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 6px 8px;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .mobile-nav__sub a span {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .mobile-nav__sub a:hover {
    background: var(--gray);
  }
  .mobile-nav__sub--icons {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .mobile-nav__sub--icons :global(.icon) {
    color: var(--navy);
    flex: none;
  }
  .mobile-nav__all {
    grid-column: 1 / -1;
  }
  .mobile-nav__all a {
    color: var(--blue);
    font-weight: 650;
  }
  .mobile-nav__contact {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }
  /* Without JavaScript, fall back to CSS hover/focus for the mega menus */
  :global(html:not(.js)) .nav-item:hover .mega,
  :global(html:not(.js)) .nav-item:focus-within .mega {
    display: block;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
