---
// Company logo. On dark backgrounds (variant="light") it sits on a white card so
// the original logo colors stay readable.
import { Image } from 'astro:assets';
import logo from '../assets/logo/fomin-logo.png';

interface Props {
  variant?: 'dark' | 'light';
  height?: number;
}
const { variant = 'dark', height = 44 } = Astro.props;
const width = Math.round((logo.width / logo.height) * height);
---
<span class:list={['logo', `logo--${variant}`]}>
  <Image
    src={logo}
    alt="Fomin Windows & Doors"
    width={width}
    height={height}
    densities={[1, 2]}
    loading="eager"
    class="logo__img"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo__img {
    width: auto;
    max-width: 100%;
  }
  .logo--light {
    background: var(--white);
    padding: 12px 16px;
    border-radius: var(--radius);
  }
</style>
