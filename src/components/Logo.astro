---
interface Props {
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
---
<span class:list={['logo', `logo--${variant}`]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect x="2" y="2" width="36" height="36" rx="6" class="logo__frame" />
    <rect x="7" y="7" width="12" height="12" rx="1.5" class="logo__pane logo__pane--accent" />
    <rect x="21" y="7" width="12" height="12" rx="1.5" class="logo__pane" />
    <rect x="7" y="21" width="12" height="12" rx="1.5" class="logo__pane" />
    <rect x="21" y="21" width="12" height="12" rx="1.5" class="logo__pane" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">FOMIN</span>
    <span class="logo__sub">Windows &amp; Doors</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }
  .logo__mark {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .logo__frame {
    fill: var(--navy);
  }
  .logo__pane {
    fill: #dfe9f7;
  }
  .logo__pane--accent {
    fill: var(--blue);
  }
  .logo--light .logo__frame {
    fill: var(--white);
  }
  .logo--light .logo__pane {
    fill: var(--navy-700);
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .logo__name {
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    color: var(--navy);
  }
  .logo__sub {
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gray-600);
  }
  .logo--light .logo__name {
    color: var(--white);
  }
  .logo--light .logo__sub {
    color: #b9c8d8;
  }
</style>
