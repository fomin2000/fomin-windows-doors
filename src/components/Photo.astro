---
// Optimized photo slot.
// Drop a photo into src/assets/photos/ named `<name>.jpg` (or .jpeg/.png/.webp)
// and it is automatically resized, converted to WebP and served responsively.
// Until then, a neutral daylight placeholder is shown that says which photo is needed.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { SHOW_MISSING_CONTENT_NOTES } from '../data/site';

interface Props {
  name: string;
  alt: string;
  need?: string; // description of the photo that should go here
  ratio?: string; // CSS aspect-ratio, e.g. '4 / 3'
  icon?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  name,
  alt,
  need,
  ratio = '4 / 3',
  icon = 'picture',
  sizes = '(min-width: 900px) 50vw, 100vw',
  eager = false,
  class: className,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const match = Object.entries(files).find(([path]) => path.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === name);
const image = match?.[1].default;
---
{
  image ? (
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1600].map((w) => Math.min(w, image.width)).filter((w, i, all) => all.indexOf(w) === i)}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['photo', className]}
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <div class:list={['photo', 'photo--placeholder', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
      <span class="photo__sun" />
      <Icon name={icon} size={120} class="photo__icon" />
      {SHOW_MISSING_CONTENT_NOTES && (
        <span class="photo__note">
          <strong>Photo needed:</strong> {need ?? alt}
          <br />
          <code>src/assets/photos/{name}.jpg</code>
        </span>
      )}
    </div>
  )
}

<style>
  .photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--gray);
  }
  .photo--placeholder {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #d7e6f7 0%, #eaf2fb 55%, #f6f3ea 100%);
    color: #8aa6c4;
  }
  .photo__sun {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 246 214 / 95%) 0%, rgb(255 246 214 / 0%) 65%);
  }
  .photo--placeholder :global(.photo__icon) {
    position: relative;
    width: 32%;
    height: auto;
    max-width: 160px;
    --icon-glass: rgb(255 255 255 / 55%);
  }
  .photo__note {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    background: rgb(255 248 230 / 95%);
    border: 1.5px dashed #d99a2b;
    color: #6b4200;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .photo__note code {
    font-size: 0.75rem;
    word-break: break-all;
  }
</style>
